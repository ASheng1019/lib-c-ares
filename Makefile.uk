$(eval $(call addlib_s,libcares,$(CONFIG_LIBCARES)))
LIBCARES_URL := https://github.com/c-ares/c-ares/releases/download/v1.34.9/c-ares-1.34.9.tar.gz
LIBCARES_ORIGIN_SHA256 := 9364b70a12eb59a06830fb488d9357f90100dff0d98b23ea3593a183d43e6f2f
